# The one passcode everyone types at the gate. Make it long, not a word. The app refuses to run on the change-me value.
# Changing it signs everyone out.
GROUP_CODE=change-me-to-something-long
# Signs the session cookie, 16+ characters. Generate one: openssl rand -base64 32
SESSION_SECRET=change-me-32-plus-random-characters
# Postgres connection string. Neon is recommended, any Postgres works. Needed at build time too.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Vercel Blob read-write token. Photos, voice notes and videos cannot be uploaded without it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Set to 1 to disable uploads and show a demo banner. Only for public demos.
# DEMO_MODE=1
